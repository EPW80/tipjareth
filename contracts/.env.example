# Sepolia deployment — copy to contracts/.env and fill in. Never commit the real .env.

# JSON-RPC endpoint for Sepolia (Alchemy or Infura)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Private key of the deployer wallet, funded with Sepolia test ETH (no 0x prefix needed)
DEPLOYER_PRIVATE_KEY=your_deployer_private_key

# Etherscan API key, used by `hardhat verify`
ETHERSCAN_API_KEY=your_etherscan_api_key
